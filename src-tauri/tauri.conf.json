{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RenovaPlan",
  "version": "0.2.0",
  "identifier": "io.github.lib-locale.renovaplan",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      { "title": "RenovaPlan", "width": 1440, "height": 900, "minWidth": 1024, "minHeight": 640, "center": true }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "deb", "appimage"],
    "icon": ["../icons/32x32.png", "../icons/128x128.png", "../icons/128x128@2x.png", "../icons/icon.ico", "../icons/icon.png"],
    "shortDescription": "Plans et maquette 3D de rénovation",
    "category": "Productivity"
  }
}
